<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_biru"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/gradasi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/gradasi"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tekstur_math"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/nama_aplikasi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/nama_aplikasi"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="127dp"
        tools:ignore="MissingConstraints" />
    <EditText
        android:id="@+id/nama_pengguna"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kolom_input"
        app:layout_constraintTop_toBottomOf="@id/nama_aplikasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"
        android:hint="nama pengguna"
        android:fontFamily="sans-serif"
        />
    <EditText
        android:id="@+id/ktsandi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kolom_input"
        app:layout_constraintTop_toBottomOf="@id/nama_pengguna"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:hint="kata sandi"
        android:inputType="textPassword"
        android:fontFamily="sans-serif"
        />

    <Spinner
        android:id="@+id/kelass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kolom_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ktsandi"
        android:layout_marginTop="20dp"/>

    <LinearLayout
        android:id="@+id/linearLayoutButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/kelass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        >

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tombol_masuk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tombol_masuk"

            />
        <Space
            android:layout_width="48dp"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tombol_daftar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tombol_daftarefek"
            />

    </LinearLayout>







</androidx.constraintlayout.widget.ConstraintLayout>